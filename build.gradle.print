tasks.register("printKeyBinding") {
    doLast {
        try {
            def clazz = Class.forName("net.minecraft.client.option.KeyBinding", true, Thread.currentThread().getContextClassLoader())
            for (def c : clazz.getConstructors()) {
                println c
            }
            def catClass = Class.forName("net.minecraft.client.option.KeyBinding\$Category", true, Thread.currentThread().getContextClassLoader())
            for (def m : catClass.getMethods()) {
                println m
            }
        } catch (Exception e) {
            e.printStackTrace()
        }
    }
}
